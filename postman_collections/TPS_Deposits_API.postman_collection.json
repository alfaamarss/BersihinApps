{
	"info": {
		"_postman_id": "tps-deposits-api-001",
		"name": "TPS Deposits API",
		"description": "API untuk fitur Riwayat Setor Kolektor ke TPS (Tempat Pembuangan Sementara)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Admin Web",
			"description": "Endpoints untuk Admin Web - Melihat riwayat setor kolektor",
			"item": [
				{
					"name": "Get TPS Deposits List",
					"request": {
						"method": "GET",
