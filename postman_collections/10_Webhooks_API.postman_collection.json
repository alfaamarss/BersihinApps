		},
		{
			"name": "Test Webhook",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/midtrans/webhook/test",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "midtrans", "webhook", "test"]
				},
				"description": "Endpoint untuk testing webhook (development only)"
			}
		}
	],
