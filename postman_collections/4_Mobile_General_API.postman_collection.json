			"response": []
		},
		{
			"name": "Service Accounts",
			"item": [
				{
					"name": "Get Service Accounts",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/service-accounts?page=1&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "service-accounts"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								}
							]
						},
						"description": "Daftar service accounts user"
					}
				},
				{
					"name": "Get Service Account Detail",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
