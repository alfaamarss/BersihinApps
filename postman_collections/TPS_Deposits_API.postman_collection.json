								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/tps-deposits",
							"host": ["{{base_url}}"],
							"path": ["admin", "tps-deposits"]
						},
						"description": "Mendapatkan daftar riwayat setor kolektor ke TPS (HTML View)"
					}
				},
