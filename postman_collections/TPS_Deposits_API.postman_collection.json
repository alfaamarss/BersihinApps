						"url": {
							"raw": "{{base_url}}/api/v1/mobile/collector/tps-deposits?garbage_dump_id=1&start_date=2025-12-01&end_date=2025-12-03&per_page=15",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "collector", "tps-deposits"],
							"query": [
								{
									"key": "garbage_dump_id",
									"value": "1",
									"description": "Filter berdasarkan ID TPS"
								},
								{
									"key": "start_date",
									"value": "2025-12-01",
									"description": "Tanggal mulai (YYYY-MM-DD)"
								},
								{
									"key": "end_date",
									"value": "2025-12-03",
									"description": "Tanggal akhir (YYYY-MM-DD)"
								},
								{
									"key": "per_page",
									"value": "15",
									"description": "Jumlah data per halaman"
								}
							]
						},
						"description": "Mendapatkan riwayat setor dengan filter"
					}
				},
				{
					"name": "Get Deposit Detail",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/collector/tps-deposits/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "collector", "tps-deposits", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "ID deposit"
								}
							]
						},
						"description": "Mendapatkan detail record setor berdasarkan ID"
					}
				}
			]
		},
