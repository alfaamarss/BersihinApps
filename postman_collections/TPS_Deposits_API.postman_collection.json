		{
			"name": "Mobile Collector API",
			"description": "Endpoints untuk Mobile App Collector - Submit dan lihat riwayat setor (Untuk referensi Tim Mobile). PENTING: Collector hanya bisa melihat dan setor ke TPS yang sudah di-assign oleh admin.",
			"item": [
				{
					"name": "Get Assigned TPS List",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/collector/tps",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "collector", "tps"]
						},
						"description": "Mendapatkan daftar TPS yang di-assign ke collector yang sedang login. CATATAN: API ini hanya menampilkan TPS yang sudah di-assign ke collector melalui menu admin TPS. Jika collector belum di-assign ke TPS manapun, response akan mengembalikan array kosong."
					},
					"response": [
						{
							"name": "Success - Has Assigned TPS",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"success\": true,\n  \"message\": \"Daftar TPS berhasil diambil\",\n  \"data\": {\n    \"tps_list\": [\n      {\n        \"id\": 1,\n        \"name\": \"TPS Sukamaju\",\n        \"address\": \"Jl. Raya Sukamaju No. 10\",\n        \"latitude\": -6.2345678,\n        \"longitude\": 106.8765432,\n        \"capacity_volume\": 100.00,\n        \"capacity_weight\": 5000.00,\n        \"status\": \"active\",\n        \"kecamatan\": {\n          \"id\": 1,\n          \"name\": \"Kecamatan Cilandak\"\n        },\n        \"kelurahan\": {\n          \"id\": 5,\n          \"name\": \"Kelurahan Sukamaju\"\n        },\n        \"rw\": {\n          \"id\": 10,\n          \"name\": \"RW 05\"\n        }\n      }\n    ]\n  }\n}"
						},
						{
							"name": "Success - No Assigned TPS",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"success\": true,\n  \"message\": \"Daftar TPS berhasil diambil\",\n  \"data\": {\n    \"tps_list\": []\n  }\n}"
						}
					]
				},
				{
					"name": "Submit Deposit to TPS",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"garbage_dump_id\": 1,\n    \"latitude\": -6.2345678,\n    \"longitude\": 106.8765432,\n    \"notes\": \"Setor sampah organik dan anorganik\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/collector/tps-deposits",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "collector", "tps-deposits"]
						},
						"description": "Mencatat aktivitas setor sampah ke TPS oleh kolektor. PENTING: Collector hanya bisa setor ke TPS yang sudah di-assign ke mereka. Jika mencoba setor ke TPS yang tidak di-assign, akan mendapatkan error 403."
					},
					"response": [
						{
							"name": "Success - Deposit Created",
							"status": "Created",
							"code": 201,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"success\": true,\n  \"message\": \"Setor ke TPS berhasil dicatat\",\n  \"data\": {\n    \"id\": 1,\n    \"collector_id\": 5,\n    \"garbage_dump_id\": 1,\n    \"deposited_at\": \"2025-12-04T10:30:00+07:00\",\n    \"latitude\": -6.2345678,\n    \"longitude\": 106.8765432,\n    \"notes\": \"Setor sampah organik dan anorganik\",\n    \"garbage_dump\": {\n      \"id\": 1,\n      \"name\": \"TPS Sukamaju\",\n      \"address\": \"Jl. Raya Sukamaju No. 10\"\n    }\n  }\n}"
						},
						{
							"name": "Error - Not Assigned to TPS",
							"status": "Forbidden",
							"code": 403,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"success\": false,\n  \"message\": \"Anda tidak di-assign ke TPS ini\",\n  \"errors\": {\n    \"garbage_dump_id\": [\"Anda tidak memiliki izin untuk setor ke TPS ini\"]\n  }\n}"
						},
						{
							"name": "Error - TPS Inactive",
							"status": "Unprocessable Entity",
							"code": 422,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"success\": false,\n  \"message\": \"TPS tidak aktif\",\n  \"errors\": {\n    \"garbage_dump_id\": [\"TPS tidak aktif atau tidak tersedia\"]\n  }\n}"
						}
					]
				},
