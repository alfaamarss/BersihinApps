	},
	"item": [
		{
			"name": "Dashboard",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/mobile/dashboard",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "mobile", "dashboard"]
				},
				"description": "Dashboard umum untuk mobile app"
			},
			"response": []
		},
		{
			"name": "Areas",
			"item": [
				{
					"name": "Get Areas",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/areas",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "areas"]
						},
						"description": "Daftar area/wilayah"
					}
				},
				{
					"name": "Get RWs by Area",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/mobile/areas/:area_id/rws",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mobile", "areas", ":area_id", "rws"],
							"variable": [
								{
									"key": "area_id",
									"value": "1"
								}
							]
						},
						"description": "Daftar RW berdasarkan area"
					}
				}
			]
		},
		{
			"name": "App Settings",
			"request": {
				"method": "GET",
